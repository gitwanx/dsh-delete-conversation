{
    "name":  "@local/dsh-delete-conversation",
    "version":  "0.1.0",
    "private":  false,
    "type":  "module",
    "description":  "Delete a conversation from the workspace sidebar: the stored session moves to sessions.trash and the row disappears after a reload.",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-workspace",
                                              "@deepseek-ai/dsh-client-locale"
                                          ]
                           }
            },
    "license":  "MIT"
}
